# ---------------------------------------------------------------------------
# The Shrub Lodge — environment variables
# Copy this file to `.env.local` and fill in the keys you want to use.
# `npm run dev` must be restarted after changing these.
# ---------------------------------------------------------------------------

# --- AI assistant (Shrub Assist) -------------------------------------------
# Get a free key at https://aistudio.google.com/apikey
# Without it the assistant still works, using the built-in offline engine.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-flash-latest, an
# alias Google keeps pointed at its newest Flash model)
GEMINI_MODEL=

# --- Contact form email delivery -------------------------------------------
# Option A (simplest): Web3Forms — create a free access key at
# https://web3forms.com and sign up with the inbox you want messages to reach.
# The key is tied to that inbox, so no domain setup is needed.
WEB3FORMS_ACCESS_KEY=

# The form submits to Web3Forms straight from the visitor's browser (Web3Forms
# blocks server-side calls), so the key is also exposed to the client. That is
# by design — a Web3Forms access key can only ever deliver to your own inbox.
# Set this NEXT_PUBLIC_ copy and the form works with no extra setup.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Option B: Resend — create a free key at https://resend.com
# (without a verified domain you can only send to the address you signed up with)
RESEND_API_KEY=

# Optional with Resend: where enquiries are delivered (falls back to the
# reservations address in src/lib/site.ts)
CONTACT_TO_EMAIL=reservations@theshrublodge.com

# Optional with Resend: the "from" address. Must be a verified domain once you
# have one; defaults to "The Shrub Lodge Website <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=
